PORT=8080
HOST=127.0.0.1
STORAGE_DRIVER=json
DATABASE_URL=
DATA_FILE=__TERMUX_DATA_FILE__
ADMIN_API_KEY=__GENERATE_ON_INSTALL__
# Заполняется мастером Cloudflare Tunnel. Через этот hostname доступны только health и webhook.
PUBLIC_BASE_URL=
# quick — временный trycloudflare.com, fixed — постоянный tunnel token + собственный домен.
CLOUDFLARE_TUNNEL_MODE=quick

VK_CALLBACK_SECRET=__GENERATE_VK_CALLBACK_SECRET__
VK_CONFIRMATION_CODE=
TELEGRAM_WEBHOOK_SECRET=__GENERATE_TELEGRAM_WEBHOOK_SECRET__
META_VERIFY_TOKEN=__GENERATE_META_VERIFY_TOKEN__
META_APP_SECRET=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_WORKER_INTERVAL_MS=10000

TELEGRAM_BOT_TOKEN=
VK_ACCESS_TOKEN=
# Пример: [{"id":"main","label":"Основной VK","token":"vk1.a...","dailyLimit":10}]
VK_COMMENT_ACCOUNTS_JSON=[]
VK_API_VERSION=5.199
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
OUTREACH_WORKER_INTERVAL_MS=10000
